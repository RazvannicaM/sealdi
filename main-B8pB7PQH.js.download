xample.com",role:"Role",member:"Member",admin:"Admin",adminDescription:"Manage team settings, members and billings",memberDescription:"Can create tasks and see what others are building",createProject:"Create Project"},u6t={new:"NEW",title:"Introducing Projects",subtitle:"A new chapter for your team",description:"As one of our first Team plan users, your feedback shaped how collaboration works. Today, we're making collaboration free for everyone by evolving Teams into Projects.",seeWhatsNew:"See what's new"},p6t={header:"Here's what's new:",okayGotIt:"Okay, got it",learnMore:"Learn more",moveTasks:{title:"Organise Tasks Cleanly",description:"As a much-requested feature, you can now move tasks and all connected forks into one place."},collaboration:{title:"No limit on collaboration",description:"You can now create unlimited Projects and add unlimited collaborators per Project."},credits:{title:"What happens to my credits?",description:"We've retired Team plan and moved all your credits to your personal plan. You now have one central balance to manage and track your usage."},staysSame:{title:"Everything stays same",description:"We are moving your subscription to Pro plan next billing cycle, all the same benefits"}},m6t={verificationRequired:"Please complete the security verification"},f6t={continueWithPhone:"Continue with Phone",phonePlaceholder:"Phone",phoneNumberPlaceholder:"Phone number",namePlaceholder:"Name",passwordPlaceholder:"Password",loginButton:"Login",sendingCode:"Sending code...",loggingIn:"Logging in...",getCode:"Get code",sending:"Sending",verifying:"Verifying",edit:"Edit",otpInstruction:"Enter the 6-digit code sent to",resendIn:"resend in {{seconds}}s",resend:"resend",passwordReset:{sendResetCode:"Send Reset Code",resendIn:"Resend in {{seconds}}s",resendCode:"Resend code",otpSubtitle:"We have sent a verification code to",requestSubtitle:"Enter the phone number associated with your account, and we'll send you a code to reset your password."},errors:{invalidPhone:"Please enter a valid phone number",otpIncomplete:"Please enter the complete 6-digit code",otpInvalid:"Invalid code, please try again",sessionExpired:"Session expired, please try again",otpSendFailed:"Unable to send verification code. Please try again later.",resetCodeFailed:"Failed to send reset code. Please try again.",verificationRequired:"Verification Required",verifyPhone:"Please verify your phone number to continue",sendCodeFailed:"Failed to send verification code. Please try again.",invalidSignin:"Invalid phone number or password",nameRequired:"Please enter your name",passwordTooShort:"Password must be at least 6 characters",passwordRequirementsNotMet:"Please ensure all password requirements are met",resendFailed:"Failed to resend code",rateLimited:"Too many attempts. Please wait a moment before trying again.",dailyLimitExceeded:"SMS limit reached for today. Please try again tomorrow.",userAlreadyExists:"An account already exists. Please log in instead."}},h6t={items:{1:{name:"Hospitality",category:"Landing page",description:"A premium hotel marketing website to showcase luxury properties, capture guest inquiries, and manage bookings with multilingual support and a built-in admin dashboard.",features:["Property and room listings with photos and pricing","Seasonal rates and exclusive travel packages","Multilingual support (English, Spanish, French, German, Chinese)","Guest inquiry form with auto-fill for logged-in users","Admin dashboard with lead management and CSV export","User authentication (Email + Google Login)","Filterable photo gallery with lightbox",'Mobile responsive with sticky "Check Availability" CTA'],pages:["Homepage","Rooms & Suites","Rates & Packages","Amenities","Location","Gallery","Guest Reviews","Contact","Admin Dashboard"]},2:{name:"Healthcare",category:"Landing page",description:"A full-stack healthcare clinic website to showcase medical services, capture patient leads, and manage appointments with a built-in admin panel.",features:["Services listings across various medical categories","Online appointment booking with doctor selection","Admin panel with lead dashboard","Doctor directory with specialty filters","Blog, FAQ, and contact pages","WhatsApp floating button","Mobile responsive"],pages:["Homepage","Services","Doctors","Blog","Contact","FAQ","Admin Panel"]},3:{name:"Real Estate",category:"Lead generation",description:"A full-stack real estate platform to showcase property listings, connect buyers with agents, and capture leads — with multilingual support, interactive maps, and a mortgage calculator. Fully customisable.",features:["Property listings with search, filters, and map/list toggle","Interactive maps with Leaflet and neighbourhood livability scores","Mortgage calculator with draggable sliders","Agent profiles with direct call and email CTAs","Multilingual support (English, Spanish, Chinese, Hindi, Arabic)","Admin dashboard with lead management and property CRUD","WhatsApp floating chat button","Mobile responsive with Framer Motion animations"],pages:["Homepage","Properties","Property Detail","Agents","Areas","Calculator","Contact","Admin Dashboard"]},4:{name:"Automotive",category:"Lead generation",description:"A conversion-focused automotive landing page for service centers and dealerships — with test drive scheduling, financing calculator, trade-in valuation, and a full admin dashboard to manage all leads. Fully customisable.",features:["Vehicle inventory carousel with filters and test drive booking","Service booking form with client-side and server-side validation","Financing calculator with real-time monthly payment estimates","Trade-in valuation form","Admin dashboard with lead management and analytics charts","Google OAuth + JWT authentication","WhatsApp and Call Now floating buttons","Mobile responsive with dark glassmorphic design"],pages:["Landing Page","Admin Dashboard — Overview","Admin Dashboard — Leads","Admin Dashboard — Inventory"]},5:{name:"Task Manager",category:"Full-stack app",description:"A full-stack project management app to organize work across teams with Kanban boards, sprint planning, and real-time task tracking — complete with a built-in admin dashboard.",features:["Kanban board with drag-and-drop across status columns (To Do, In Progress, In Review, Done)","Board / List view toggle for every project","Auto-numbered task keys per project (e.g. MAR-1, MAR-2)","Task priorities (Critical, High, Medium, Low) with color-coded indicators","Due dates, labels, and threaded comments on tasks","Sprint management with filtered project views","Dashboard with task stats, status breakdowns, and project summaries","Multilingual support (English, Spanish, French, German, Chinese)"],pages:["Dashboard","Projects","Board (Kanban)","List View","Task Detail","Sprints"]},6:{name:"Beauty Services",category:"Landing page",description:"A ready-to-deploy beauty salon website to showcase services, manage stylist bookings, and capture client appointments — with a 3-step booking flow and a full admin portal.",features:["60+ services across 6 categories with search, pricing, and duration","3-step appointment booking (Service → Date & Time → Contact Info)","Admin portal with booking management and analytics dashboard","Stylist profiles with specialties and booking CTAs","Gallery with category filters and Instagram CTA","Booking confirmation with reference number and print option","WhatsApp floating button","Mobile responsive"],pages:["Homepage","Services & Pricing","Gallery","Our Team","Location & Hours","Book Appointment","Booking Confirmation","Admin Portal"]},7:{name:"Legal Services",category:"Landing page",description:"A multi-page legal services platform to showcase practice areas, connect clients with attorneys, and capture free consultation bookings — with multilingual support and a dynamic CMS admin portal.",features:["Dynamic service pages for 6 practice areas with detailed breakdowns","Consultation booking modal with attorney pre-selection","Admin portal with consultation inbox and status tracking","Dynamic CMS settings — edit firm details without redeploying","Multilingual support (English, Spanish, French, German, Chinese)","SEO meta tags with Open Graph per page","WhatsApp and call floating buttons","Mobile responsive with scroll-triggered animations"],pages:["Homepage (10 sections)","Service Detail Pages","Admin Portal (Inbox)","Dashboard","CMS Settings"]},8:{name:"Lead Gen Base",category:"Landing page",description:"A full-stack lead generation website with 15 pages — including blog, portfolio, pricing tiers, and a Calendly booking integration — designed to capture leads through contact forms, quote requests, and newsletter signups.",features:["3 lead capture channels (contact form, quote request, newsletter)","3-tier pricing page with highlighted plan","Blog with search, category filters, and social sharing","Portfolio with masonry grid and detail modals","Calendly booking integration (configurable)","Dark/Light mode toggle (persisted)","Admin panel with lead pipeline, quotes, and subscriber management","Mobile responsive with Framer Motion animations"],pages:["Homepage","About","Services","Service Detail","Pricing","Blog","Blog Detail","FAQ","Portfolio","Contact","Booking","Quote","Privacy Policy","Terms of Service","Admin Panel"]},9:{name:"Construction",category:"Landing page",description:"A professional construction and engineering website to showcase services, display project portfolios, and capture leads through a multi-step quote request form — with a full admin portal for lead and inventory management.",features:["Multi-step quote form (project type → details → contact → file upload)","9 service categories with descriptions and feature lists","Project portfolio with 12 works across 3 categories","Financing calculator with real-time estimates","Admin dashboard with lead analytics and status tracking","Newsletter signup and Google Maps location section","WhatsApp and Call Now floating buttons","Mobile responsive with dark + red-orange theme"],pages:["Homepage","Services","Portfolio","Process","About Us","Service Areas","Contact","Quote Request","Admin Dashboard"]},10:{name:"Real Estate CRM",category:"Full-stack app",description:"A ready-to-deploy CRM built for small and mid-sized real estate agencies. Gives your team a complete lead-to-close workflow out of the box, with realistic demo data already loaded so you can evaluate it in minutes.",features:["Role-based access control — Admin, Manager, and Agent roles with scoped visibility","Visual pipeline board — drag-and-drop Kanban moving leads through stages","Lead management — full-featured table with 15+ fields, search, filtering, and CSV import","Property listings — grid view with photos, pricing, address, and availability badges","Performance dashboard — summary cards, funnel, trend, and source charts","Conversion reporting — lead funnel analysis, stage breakdown, and conversion stats","Demo-ready data — ships with realistic sample leads, properties, and pipeline activity","One-click role switching — preview Admin, Manager, and Agent experiences"],pages:["Login","Dashboard","Leads","Pipeline","Properties","Reports"]}}},x6t={wordOfTheDay:"Build a Word of the Day app with daily words and quizzes",billGenerator:"Build a cafe billing app to add items and generate bills",flappyBirdGame:"Build a Flappy Bird game with smooth controls and leaderboard",recipeGenerator:"Build a recipe app that generates recipes from ingredients",habitTracker:"Build a habit tracker app with tracking and progress indicators",breathingSpace:"Build a breathing exercise app with guided animations and session history",saasPrd:"Write a PRD for a SaaS project management tool with user stories and success metrics",cloneBreakdown:"Break down how Notion works and outline an MVP plan to clone the essentials",userJourneyMap:"Map the full user journey for an e-commerce app from first visit to checkout",featurePrioritization:"Priori